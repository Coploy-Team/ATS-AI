# Coploy ATS open — copie para .env.open e ajuste.
# Gere segredos com: openssl rand -hex 32

# Banco (fica só na sua máquina)
POSTGRES_PASSWORD=troque-esta-senha

# Arquivos (MinIO)
MINIO_ACCESS_KEY=coploy
MINIO_SECRET_KEY=troque-esta-senha

# Sessões de login
BETTERAUTH_SECRET=

# Chave interna entre serviços
CORE_API_KEY=

# Base pública (sem porta). Local: http://localhost
# Num servidor: http://SEU-IP ou https://seu-dominio
PUBLIC_BASE_URL=http://localhost

# Portal público de vagas — a porta de entrada do candidato.
# É para cá que o convite de entrevista aponta. Local: deixe como está.
# Num servidor: http://SEU-IP:8081 ou https://vagas.seu-dominio
CAREERS_PUBLIC_URL=http://localhost:8081

# E-mail transacional
# O jeito recomendado é a tela do produto: ATS → Configuração → Servidor,
# onde o dono da conta configura SMTP e manda um e-mail de teste.
# As opções abaixo existem para quem prefere configurar por arquivo:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Sua Empresa <vagas@suaempresa.com>"
# POSTMARK_API_KEY=

# Motor Coploy (plugin de entrevista com IA) — NÃO preencha à mão.
# Ative a licença em ATS → Configuração → Servidor → Plugin e rode o comando
# de instalação que a tela mostra: ele escreve estas variáveis para você.
# MOTOR_ENABLED=true
# MOTOR_ENGINE_URL=http://motor-ai-engine:8080
# MOTOR_ORCHESTRATOR_URL=http://motor-orchestrator:4444
# MOTOR_INTERVIEW_BASE_URL=http://localhost:8082
