# Coploy ATS open — copie para .env.open e ajuste.
# Gere segredos com: openssl rand -hex 32

# Banco (fica só na sua máquina)
POSTGRES_PASSWORD=troque-esta-senha

# Arquivos (MinIO)
MINIO_ACCESS_KEY=coploy
MINIO_SECRET_KEY=troque-esta-senha

# Sessões de login
BETTERAUTH_SECRET=

# Chave interna entre serviços
CORE_API_KEY=

# Base pública (sem porta). Local: http://localhost
# Num servidor: http://SEU-IP ou https://seu-dominio
PUBLIC_BASE_URL=http://localhost

# E-mail transacional (opcional — sem isso os envios são pulados)
# POSTMARK_API_KEY=

# Motor Coploy (plugin) — preencha quando instalar
# MOTOR_ENABLED=true
# MOTOR_ENGINE_URL=
# MOTOR_ORCHESTRATOR_URL=
# MOTOR_INTERVIEW_BASE_URL=
