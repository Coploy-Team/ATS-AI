{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env"],
  "globalEnv": ["NODE_ENV", "INFRA_PROVIDER"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", "dist/**"],
      "env": ["VITE_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:gcp": {
      "cache": false,
      "persistent": true
    },
    "dev:local": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["NODE_ENV"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "generate:openapi": {
      "dependsOn": ["^build"],
      "outputs": ["openapi.json"],
      "cache": false
    },
    "generate:api": {
      "dependsOn": ["core#generate:openapi"],
      "outputs": ["src/shared/api/generated.ts"],
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "format": {
      "cache": false
    }
  }
}
