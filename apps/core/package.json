{
  "name": "core",
  "version": "1.1.0",
  "private": true,
  "description": "Recruiter REST API - manages companies, jobs, interviews, billing, and collaborators",
  "main": "./build/server.js",
  "scripts": {
    "build": "tsup src/http/server.ts --format cjs --clean --out-dir build",
    "dev": "cross-env NODE_ENV=homolog tsx watch src/http/server.ts",
    "dev:gcp": "cross-env NODE_ENV=homolog INFRA_PROVIDER=gcp tsx watch src/http/server.ts",
    "dev:local": "cross-env NODE_ENV=homolog INFRA_PROVIDER=selfhosted tsx watch src/http/server.ts",
    "dev:production": "cross-env NODE_ENV=production tsx watch src/http/server.ts",
    "start": "node build/server.js",
    "generate:openapi": "tsx src/scripts/generate-openapi.ts",
    "generate:openapi:public": "tsx src/scripts/generate-public-openapi.ts",
    "check:public-contract": "tsx src/scripts/generate-public-openapi.ts && git diff --exit-code -- openapi.public.json",
    "clean": "rm -rf build .turbo",
    "lint": "tsc --noEmit",
    "test": "jest",
    "check:rbac-coverage": "tsx src/scripts/check-rbac-coverage.ts",
    "check:response-fields": "tsx src/scripts/check-response-allowlists.ts"
  },
  "dependencies": {
    "@aws-sdk/client-route-53": "3.858.0",
    "@coploy/domain": "*",
    "@coploy/infra": "*",
    "@coploy/shared": "*",
    "@fastify/cors": "^10.1.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "@types/nodemailer": "^8.0.1",
    "axios": "^1.9.0",
    "better-auth": "^1.4.18",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "nanoid": "^5.1.5",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.17.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.8.1",
    "@types/pdfkit": "^0.13.9",
    "cross-env": "^7.0.3",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsup": "^8.3.6",
    "tsx": "^4.15.2",
    "typescript": "^5.7.0"
  }
}
