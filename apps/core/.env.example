# =============================================================================
# core — variáveis de ambiente
#
# O caminho normal é NÃO usar este arquivo: o `docker-compose.open.yml` da
# raiz injeta tudo isto no container (você só preenche o `.env.open` da
# raiz, a partir do `.env.open.example`). Este arquivo serve pra quem roda o
# core solto (`npm run dev --workspace=core`) fora do compose.
# =============================================================================

SERVER_PORT=3333
NODE_ENV=production

# "selfhosted" (PostgreSQL — o modo desta distribuição) ou "gcp"
# (Firebase/Firestore — o modo da hospedagem da Coploy; ver seção no fim).
INFRA_PROVIDER=selfhosted

# ── Banco (selfhosted) ───────────────────────────────────────────────────────
POSTGRES_URL=postgresql://coploy:change-me@localhost:5432/coploy
POSTGRES_SCHEMA=public
POSTGRES_SSL=false

# ── Storage (MinIO ou qualquer S3) ───────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=coploy
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000/coploy

# ── Auth (BetterAuth) ────────────────────────────────────────────────────────
# openssl rand -hex 32
BETTERAUTH_SECRET=change-me
BETTERAUTH_URL=http://localhost:3333
# origens dos web apps (ats, careers)
AUTH_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:8081

# ── Fila e cache ─────────────────────────────────────────────────────────────
REDIS_URL=redis://:coploy@localhost:6379
RABBITMQ_URL=amqp://coploy:coploy@localhost:5672

# ── Integração interna ───────────────────────────────────────────────────────
# openssl rand -hex 32
CORE_API_KEY=change-me-internal-api-key

# ── E-mail (opcional — sem ele, nenhum e-mail sai) ───────────────────────────
POSTMARK_API_KEY=

# ── Motor Coploy (plugin de entrevista por IA — opcional) ────────────────────
# Sem o plugin, o ATS funciona como um ATS normal; com ele, a entrevista por
# IA entra no fluxo. As URLs vêm da instalação do plugin.
MOTOR_ENABLED=false
ENGINE_URL=http://motor-nao-instalado:1
INTEGRATION_URL=http://motor-nao-instalado:1
INTERVIEW_BASE_URL=http://motor-nao-instalado:1
# A chave de licença do plugin é ativada pela tela Servidor → Plugin (não é
# env). Este endereço só muda se a Coploy indicar outro servidor de licenças.
MOTOR_LICENSE_SERVER_URL=

# ── OTS — emissão de prova de entrevista verificada (opcional) ───────────────
# Esta instância pode EMITIR attestations (modelo federado): gere uma chave
# com `openssl genpkey -algorithm ed25519` e aponte o issuer pra URL pública
# deste core. Sem as duas, a emissão responde 503; a verificação de provas
# de outros emissores funciona sempre.
OTS_SIGNING_KEY=
OTS_SIGNING_KID=ots-2026-1
OTS_ISSUER_BASE_URL=

# =============================================================================
# INFRA_PROVIDER=gcp — o modo da hospedagem da Coploy (opcional)
#
# Só preencha esta seção se você mesmo hospeda em Firebase/GCP. No modo
# selfhosted acima, nada daqui é lido.
# =============================================================================
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=
# FIREBASE_DEFAULT_DATABASE_URL=
# FIREBASE_HOSTING_URL=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_HOSTED_ZONE_ID=
