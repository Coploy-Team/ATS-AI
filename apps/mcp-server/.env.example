# MCP do candidato — instalação própria. O docker-compose.open.yml já passa tudo isto.
INFRA_PROVIDER=selfhosted
NODE_ENV=production
SERVER_PORT=5558

# Mesmo banco e mesma sessão de login do core
POSTGRES_URL=postgresql://coploy:senha@localhost:5432/coploy
BETTERAUTH_SECRET=
BETTERAUTH_URL=http://localhost:3333
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=coploy
MINIO_USE_SSL=false

# A API desta instância
CORE_BASE_URL=http://localhost:3333

# Endereço que o assistente alcança — issuer dos metadados OAuth
PUBLIC_BASE_URL=http://localhost:5558
# Assina os tokens do assistente conectado (gerar: openssl rand -hex 32)
MCP_OAUTH_SIGNING_SECRET=
# true = /mcp exige login (401 dispara a descoberta OAuth nos assistentes)
MCP_REQUIRE_AUTH=false

# Portal público de vagas: sem o Motor, é para onde a vaga aponta
CAREERS_BASE_URL=http://localhost:8081
# Motor de entrevista (plugin). Vazio = não instalado.
INTERVIEW_BASE_URL=
ORCHESTRATOR_BASE_URL=
# A área do candidato não faz parte desta distribuição. Deixe vazio.
CANDIDATE_APP_URL=
