# Portal público de vagas — variáveis de ambiente
#
# O caminho normal é NÃO usar este arquivo: o `docker-compose.open.yml` da
# raiz builda o careers com tudo isto injetado. Este .env é pra quem roda o
# `npm run dev` do careers solto, fora do compose.

# O backend DESTA distribuição (o core do compose).
VITE_API_CORE_URL=http://localhost:3333

# Provedor de origem do perfil portátil OTS — habilita o "importar minha
# trajetória" no formulário de candidatura. Vazio desliga o card.
VITE_OTS_PROFILE_PROVIDER=
