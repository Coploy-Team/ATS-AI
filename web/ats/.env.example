# Origem da API que fala o contrato Coploy — o SEU backend.
#
# O caminho normal é nem precisar deste arquivo: o `docker-compose.open.yml`
# da raiz sobe tudo e builda o ats apontando pro core dele, com BetterAuth.
# Este .env é pra quem roda o `npm run dev` do ats solto, fora do compose.
#
# Este front fala com o backend DESTA distribuição. O serviço hospedado da
# Coploy tem a própria interface — apontar um clone pra API hospedada não é
# suportado.
VITE_API_CORE_URL=http://localhost:3333

# Contra o backend do compose open, o auth é BetterAuth (o Firebase embutido
# no código é o da Coploy hospedada — só faz sentido junto da API dela).
VITE_AUTH_PROVIDER=betterauth
VITE_BETTERAUTH_URL=http://localhost:3333

# ---------------------------------------------------------------------------
# Daqui para baixo, opções pra quem usa Firebase próprio no lugar do
# BetterAuth do compose (`VITE_AUTH_PROVIDER=firebase`). O import é
# dinâmico: só o provider escolhido entra no bundle.
# ---------------------------------------------------------------------------

# Configuração web do seu projeto Firebase (Console → Configurações do projeto
# → Seus apps → Web). Qualquer campo omitido cai no padrão da Coploy.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_DATABASE_URL=
# VITE_FIREBASE_MEASUREMENT_ID=
