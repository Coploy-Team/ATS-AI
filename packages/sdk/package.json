{
	"name": "@coploy/sdk",
	"version": "0.67.0",
	"description": "SDK oficial da Coploy Public API — gerado do contrato público (openapi.public.json).",
	"license": "Apache-2.0",
	"main": "./build/index.js",
	"types": "./build/index.d.ts",
	"exports": {
		".": {
			"types": "./build/index.d.ts",
			"import": "./build/index.mjs",
			"require": "./build/index.js"
		},
		"./react": {
			"types": "./build/react.d.ts",
			"import": "./build/react.mjs",
			"require": "./build/react.js"
		}
	},
	"files": [
		"build",
		"LICENSE",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"split": "node scripts/split-spec.mjs",
		"generate": "npm run split && orval --config orval.config.ts",
		"check:generated": "npm run generate && git diff --exit-code -- src/generated",
		"build": "tsup src/index.ts src/react.ts --format cjs,esm --dts --clean --out-dir build",
		"clean": "rm -rf build .turbo .orval",
		"lint": "tsc --noEmit",
		"test": "jest",
		"prepublishOnly": "npm run check:generated && npm run build"
	},
	"peerDependencies": {
		"@tanstack/react-query": "^5.0.0"
	},
	"peerDependenciesMeta": {
		"@tanstack/react-query": {
			"optional": true
		}
	},
	"devDependencies": {
		"@tanstack/react-query": "^5.62.0",
		"@types/jest": "^29.5.14",
		"jest": "^29.7.0",
		"orval": "^7.9.0",
		"ts-jest": "^29.2.5",
		"tsup": "^8.3.6",
		"typescript": "^5.7.0",
		"zod": "^3.24.1"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Coploy-Team/ATS-AI.git",
		"directory": "packages/sdk"
	},
	"homepage": "https://github.com/Coploy-Team/ATS-AI/tree/main/packages/sdk#readme",
	"bugs": {
		"url": "https://github.com/Coploy-Team/ATS-AI/issues"
	},
	"keywords": [
		"coploy",
		"ats",
		"recruiting",
		"openapi",
		"sdk",
		"ots",
		"open-talent-standard"
	]
}
