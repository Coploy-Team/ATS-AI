{
  "name": "coploy-platform",
  "version": "1.1.0",
  "private": true,
  "description": "Coploy Platform - Monorepo for the complete Coploy ecosystem",
  "workspaces": [
    "packages/*",
    "apps/*",
    "web/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=20",
    "dev:gcp": "turbo run dev:gcp --concurrency=20",
    "dev:local": "turbo run dev:local --concurrency=20",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "turbo run format"
  },
  "devDependencies": {
    "turbo": "^2.9.4",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "better-auth": {
      "jose": "^6.1.3"
    },
    "@better-auth/core": {
      "jose": "^6.1.3"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@10.9.0"
}
